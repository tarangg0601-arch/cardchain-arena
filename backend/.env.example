# Copy this file to .env and adjust as needed.

PORT=4000

# auto   = try Fabric at startup, fall back to the local JSON ledger if it is unreachable
# fabric = Fabric only (startup fails if the network is not reachable)
# local  = local JSON ledger only (no Docker or Fabric needed)
LEDGER_MODE=auto

# Off-chain data: accounts, password hashes and sessions (auth.json) and the local ledger file.
DATA_DIR=./data

SESSION_TTL_HOURS=12

# Demo mode enables one-click login for the seeded players player1 and player2.
DEMO_MODE=true
DEMO_PASSWORD=demo1234

# Hyperledger Fabric connection (defaults match fabric-samples/test-network, Org1).
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=tcg
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# Path to test-network/organizations/peerOrganizations/org1.example.com.
# Relative paths are resolved from the backend folder.
FABRIC_CRYPTO_PATH=../../fabric-samples/test-network/organizations/peerOrganizations/org1.example.com
# Optional overrides if your files are elsewhere:
# FABRIC_CERT_DIR=
# FABRIC_KEY_DIR=
# FABRIC_TLS_CERT_PATH=
FABRIC_CONNECT_TIMEOUT_MS=5000
